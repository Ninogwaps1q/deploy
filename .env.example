# Flask Configuration
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
BUS_OPERATOR_EMAIL=bus-operator@example.com
BUS_OPERATOR_PASSWORD=replace-with-a-unique-strong-password
CINEMA_OPERATOR_EMAIL=cinema-operator@example.com
CINEMA_OPERATOR_PASSWORD=replace-with-a-unique-strong-password

# Database Configuration
DATABASE_URL=sqlite:///ticketing.db
# For production PostgreSQL use: postgresql://user:password@host:port/dbname
# For production MySQL use: mysql+pymysql://user:password@host:port/dbname

# PayMongo Configuration
PAYMONGO_SECRET_KEY=your-paymongo-secret-key
PAYMONGO_PUBLIC_KEY=your-paymongo-public-key

# Email Configuration (for password reset and notifications)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# Google Generative AI (for chatbot)
GOOGLE_API_KEY=your-google-api-key

# Application Settings
DEBUG=False
